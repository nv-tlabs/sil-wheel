# ============================================================================
# SIL Wheel Agent - credentials for YOUR SIL Wheel deployment
# ============================================================================
# Usage: cp .env.template .env  &&  edit .env
#   - .env is gitignored - NEVER commit it
#   - This client ships no server and no credentials. Point it at the SIL
#     Wheel instance you run or have been given access to.
# ============================================================================

# The SIL Wheel server you have access to (self-hosted, or one provided to you).
WHEEL_SERVER_URL=http://localhost:8000

# Your login for that server.
WHEEL_USERNAME=
WHEEL_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: separate dev/sandbox server for write ops (labeling, classifiers)
# ---------------------------------------------------------------------------
# WHEEL_DEV_URL=http://localhost:8018
# WHEEL_DEV_USER=
# WHEEL_DEV_PASSWORD=

# ---------------------------------------------------------------------------
# Optional: protect a server from writes
# ---------------------------------------------------------------------------
# Mark the server read-only so the agent refuses label/annotation/classifier
# writes. Set this for a shared or production deployment that should never be
# written to. Unset (default), writes are allowed (you own your server).
# WHEEL_READONLY=1

# ---------------------------------------------------------------------------
# Optional behavior toggles
# ---------------------------------------------------------------------------
# Promote silent zero-result footguns to exceptions in autonomous loops:
# WHEEL_STRICT=1

# Make login raise instead of returning False (and retry N times):
# WHEEL_LOGIN_RAISE=1
# WHEEL_LOGIN_RETRIES=3

# Override where the SDK checks for updates (defaults to the GitHub release):
# WHEEL_SKILL_URL=
